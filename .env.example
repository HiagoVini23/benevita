# Copie para .env e ajuste se necessário: cp .env.example .env
# Valores abaixo são apenas para desenvolvimento local — nunca use em produção.

# Backend
NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Banco (mesmas credenciais do docker-compose.yml)
DATABASE_URL=postgresql://benevita:benevita@localhost:5432/benevita?schema=public

# Autenticação — gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-characters
JWT_EXPIRES_IN=8h

# Frontend (proxy do Vite para a API em desenvolvimento)
API_URL=http://localhost:3333
