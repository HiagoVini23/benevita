generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient          Patient?
  createdReports   Report[] @relation("ReportCreatedBy")
  publishedReports Report[] @relation("ReportPublishedBy")

  @@map("users")
}

model Patient {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  birthDate DateTime @map("birth_date") @db.Date
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@map("patients")
}

model ExamType {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique

  appointments Appointment[]

  @@map("exam_types")
}

model Professional {
  id        String @id @default(uuid(7)) @db.Uuid
  name      String
  crm       String @unique
  specialty String

  reports Report[]

  @@map("professionals")
}

/// Unique active slot (R2/R3) is a partial unique index created in the migration SQL.
model Appointment {
  id          String            @id @default(uuid(7)) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  examTypeId  String            @map("exam_type_id") @db.Uuid
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz(3)
  status      AppointmentStatus @default(SCHEDULED)
  canceledAt  DateTime?         @map("canceled_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  patient  Patient  @relation(fields: [patientId], references: [id])
  examType ExamType @relation(fields: [examTypeId], references: [id])
  report   Report?

  @@index([patientId])
  @@map("appointments")
}

/// PUBLISHED <=> published_at/published_by_id set (L7) is a CHECK constraint in the migration SQL.
model Report {
  id             String       @id @default(uuid(7)) @db.Uuid
  appointmentId  String       @unique @map("appointment_id") @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  title          String
  body           String
  status         ReportStatus @default(DRAFT)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  createdById    String       @map("created_by_id") @db.Uuid
  publishedById  String?      @map("published_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  createdBy    User         @relation("ReportCreatedBy", fields: [createdById], references: [id])
  publishedBy  User?        @relation("ReportPublishedBy", fields: [publishedById], references: [id])

  @@map("reports")
}
